# Pharos Atlantic testnet RPC
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com

# Wallet that pays for / settles agent service calls (hex, 0x-prefixed).
# In the paying agent this is the spender; in the settling agent it is the relayer.
WALLET_PRIVATE_KEY=

# Optional: default ERC-20 used for settlement (defaults to testnet USDC)
PAYMENT_TOKEN_ADDRESS=0x72df0bcd7276f2dFbAc900D1CE63c272C4BCcCED

# Optional: directory where settlement receipts are written (default ./receipts)
RECEIPTS_DIR=./receipts
